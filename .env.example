# Required
OPENAI_API_KEY=sk-...

# Core model. Current recommended flagship alias can be changed without code edits.
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium

# Workspace confinement: file tools and shell commands cannot escape this directory.
AGENT_WORKSPACE=.
AGENT_NAME=Nova
AGENT_PROMPT_FILE=AGENT.md
AGENT_MEMORY_DB=memory/agent.db
AGENT_MEMORY_VAULT=memory/vault

# Capabilities
ENABLE_WEB_SEARCH=true
ENABLE_WRITE_TOOLS=true
ENABLE_SHELL_TOOL=true

# Shell safety
# Risky commands always prompt for confirmation in interactive mode.
SHELL_TIMEOUT_SECONDS=30
