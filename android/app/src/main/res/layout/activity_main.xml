<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sentinel_root_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/astra_muted"
            android:textSize="20sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.22"
                android:text="ASTRA"
                android:textColor="@color/astra_text"
                android:textSize="22sp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Initialisation locale…"
                android:textColor="@color/astra_accent"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/astra_muted"
            android:textSize="20sp"/>
    </LinearLayout>

    <com.sevenaction.astra.ui.CoreView
        android:id="@+id/coreView"
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="Noyau visuel Sentinel d'Astra"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.16"
        android:paddingBottom="7dp"
        android:text="ÉCOUTE  •  COMPRÉHENSION  •  ACTION"
        android:textColor="@color/astra_muted"
        android:textSize="9sp"/>

    <ScrollView
        android:id="@+id/conversationScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_bg"
        android:clipToOutline="true"
        android:fillViewport="true"
        android:minHeight="112dp"
        android:padding="13dp">

        <TextView
            android:id="@+id/conversationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="Astra est prête. Écris ou utilise le micro."
            android:textColor="@color/astra_text"
            android:textSize="15sp"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Posez votre question à ASTRA…"
            android:imeOptions="actionSend"
            android:paddingStart="15dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/astra_text"
            android:textColorHint="@color/astra_muted"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/send_button_bg"
            android:backgroundTint="@null"
            android:contentDescription="Envoyer"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textAllCaps="false"
            android:textColor="@color/astra_bg"
            android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="@drawable/action_button_primary_bg"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:paddingHorizontal="3dp"
            android:text="◉  Parler"
            android:textAllCaps="false"
            android:textColor="@color/astra_text"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/meetingButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/action_button_bg"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:paddingHorizontal="3dp"
            android:text="▣  Réunion"
            android:textAllCaps="false"
            android:textColor="@color/astra_text"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/memoryButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/action_button_bg"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:paddingHorizontal="3dp"
            android:text="◆  Mémoire"
            android:textAllCaps="false"
            android:textColor="@color/astra_text"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.22"
        android:paddingTop="6dp"
        android:text="PLUS LOIN  •  AVEC VOUS"
        android:textColor="@color/astra_muted"
        android:textSize="8sp"/>
</LinearLayout>
