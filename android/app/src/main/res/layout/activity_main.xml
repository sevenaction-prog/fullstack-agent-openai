<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astra_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASTRA"
                android:textColor="@color/astra_text"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initialisation locale…"
                android:textColor="@color/astra_muted"
                android:textSize="13sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/memoryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Mémoire"/>
    </LinearLayout>

    <com.sevenaction.astra.ui.CoreView
        android:id="@+id/coreView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:contentDescription="Noyau visuel de l'assistant"/>

    <ScrollView
        android:id="@+id/conversationScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_bg"
        android:padding="14dp">

        <TextView
            android:id="@+id/conversationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Astra est prête. Écris ou utilise le micro."
            android:textColor="@color/astra_text"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Écris ta demande…"
            android:hintTextColor="@color/astra_muted"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/astra_text"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:text="Envoyer"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="🎙 Parler"/>

        <Button
            android:id="@+id/meetingButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="● Réunion"/>
    </LinearLayout>
</LinearLayout>
